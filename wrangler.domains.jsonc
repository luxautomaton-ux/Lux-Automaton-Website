    { "pattern": "www.lawcheckai.com", "custom_domain": true },
    { "pattern": "luxverifyai.com", "custom_domain": true },
    { "pattern": "www.luxverifyai.com", "custom_domain": true },
    { "pattern": "luxaikids.com", "custom_domain": true },
    { "pattern": "www.luxaikids.com", "custom_domain": true }
  ]
}
